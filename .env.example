PORT=8000
TRUEFORGE_URL=http://localhost:8790
# Optional: choose a configured TrueForge model FQN, e.g. provider/model.
# For OpenAI, configure the provider/key in TrueForge or the AI Gateway first,
# then copy the exact available model FQN here. Homeward needs no OPENAI_API_KEY.
# All specialist agents use this provider-independent selection.
